# Os artefatos de resultados (CSV, JSON, imagens, PDFs, relatórios e
# modelos treinados) são versionados. Os Parquet continuam excluídos,
# inclusive quando estiverem dentro de diretórios resultados*.
!**/resultados*/**/*.csv
!**/resultados*/**/*.pdf
!**/resultados*/**/*.png
!**/resultados*/**/*.jpg
!**/resultados*/**/*.jpeg
!**/resultados*/**/*.joblib
!**/resultados*/**/*.pt

# Resultados leves da revisão com seleção de hiperparâmetros
!/execucoes/amostra-05pct-revisao-hpo/**/*.csv
!/execucoes/amostra-05pct-revisao-hpo/**/*.pdf
!/execucoes/amostra-05pct-revisao-hpo/**/*.png

