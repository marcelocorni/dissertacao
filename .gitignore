# Dados volumosos, bancos locais e caches
**/cache/
**/.tmp/
**/execucoes/
*.parquet
*.csv
*.duckdb
*.db
*.partial
*.joblib
*.pkl
*.pt
*.pth
*.onnx
*.npy
*.npz
*.pdf
*.png
*.jpg
*.jpeg
*.log

# Os artefatos de resultados (CSV, JSON, imagens, PDFs, relatórios e
# modelos treinados) são versionados. Os Parquet continuam excluídos,
# inclusive quando estiverem dentro de diretórios resultados*.
!**/resultados*/**/*.csv
!**/resultados*/**/*.pdf
!**/resultados*/**/*.png
!**/resultados*/**/*.jpg
!**/resultados*/**/*.jpeg
!**/resultados*/**/*.joblib
!**/resultados*/**/*.pt

# Python e ambientes locais
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.ipynb_checkpoints/
*.py[cod]
.python-version

# .NET
**/bin/
**/obj/

# Configurações locais e editores
.streamlit/
.vscode/
.env
.env.*
